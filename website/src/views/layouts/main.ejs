<!DOCTYPE html>
<html lang="<%= language || 'en' %>" dir="<%= language === 'ar' ? 'rtl' : 'ltr' %>" class="is-loading">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#05050c" />
    <%- include('../partials/meta') %>
    <link rel="shortcut icon" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/images/favicons/site.webmanifest" />
    <style>
      html.is-loading,html.is-loading body{overflow:hidden}
      .page-loader{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;background:#05050c}
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Montserrat:wght@600&family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/css/styles.css?v=20260928o" />
    <link rel="stylesheet" href="/assets/css/production.css?v=20260927m" />
    <link rel="stylesheet" href="/assets/css/page-loader.css?v=20260928c" />
    <% if (typeof extraCss !== 'undefined' && extraCss && extraCss.length) { %>
      <% extraCss.forEach(function(href) { %>
    <link rel="stylesheet" href="/assets/css/<%= href %>?v=20260928d" />
      <% }); %>
    <% } %>
    <% if (typeof asasHome !== 'undefined' && asasHome) { %>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"
        }
      }
    </script>
    <% } %>
    <%- include('../partials/analytics') %>
</head>
<body<% if (typeof bodyClass !== 'undefined' && bodyClass) { %> class="<%= bodyClass %>"<% } %>>
    <%- include('../partials/page-loader') %>
    <%- include('../partials/asas-icons') %>
    <div class="app" id="app">
        <% if (typeof asasHome !== 'undefined' && asasHome) { %>
        <div id="hero-brain-overlay" class="hero-brain-overlay" hidden>
          <canvas id="hero-brain-canvas" aria-label="Interactive 3D processor"></canvas>
        </div>
        <% } %>
        <%- include('../partials/header') %>
        <%- body %>
        <%- include('../partials/footer') %>
        <% if (typeof asasHome !== 'undefined' && asasHome) { %>
        <%- include('../partials/asas-modals') %>
        <% } else if (typeof asasServicesModals !== 'undefined' && asasServicesModals) { %>
        <%- include('../partials/asas-services-modals') %>
        <% } else if (typeof asasContactModal !== 'undefined' && asasContactModal) { %>
        <%- include('../partials/asas-contact-modal') %>
        <% } %>
    </div>
    <button type="button" class="footer-top-btn" data-action="top" aria-label="Back to top" data-i18n-aria="footer.backTop" aria-hidden="true" tabindex="-1">
      <svg class="icon icon-sm" aria-hidden="true"><use href="#icon-chevron-up"></use></svg>
    </button>
    <% if (company.whatsappNumber) { %>
    <div class="whatsapp-float" id="whatsappFloat">
        <div class="whatsapp-float__bar">
            <a class="whatsapp whatsapp-float__btn" href="https://wa.me/<%= company.whatsappNumber ? company.whatsappNumber.replace(/[^+\d]/g, '') : '' %>" target="_blank" rel="noopener" aria-label="<%= company.name %> WhatsApp">
                <img border="0" alt="<%= company.name %> WhatsApp" src="/assets/images/social/whatsapp.png" width="50" height="50">
            </a>
        </div>
    </div>
    <% } %>
    <script src="/assets/js/page-loader.js?v=20260928c"></script>
    <script src="/assets/js/header-scroll.js?v=20260928a"></script>
    <script src="/assets/js/mobile-nav.js?v=20260927e"></script>
    <% if (typeof asasHome !== 'undefined' && asasHome) { %>
    <script src="/assets/js/app.js?v=20260927l"></script>
    <script type="module" src="/assets/js/brain-overlay.js?v=20260925d"></script>
    <script src="/assets/js/manifest-reveal.js"></script>
    <script src="/assets/js/why-accordion.js"></script>
    <script src="/assets/js/products-gallery.js"></script>
    <script src="/assets/js/pricing-reveal.js"></script>
    <script src="/assets/js/section-reveal.js"></script>
    <script src="/assets/js/fb-page-embed.js"></script>
    <% } %>
    <% if (typeof extraJs !== 'undefined' && extraJs && extraJs.length) { %>
      <% extraJs.forEach(function(src) { %>
    <script src="/assets/js/<%= src %>?v=20260927l"></script>
      <% }); %>
    <% } %>
    <script src="/assets/js/back-to-top.js"></script>
</body>
</html>
