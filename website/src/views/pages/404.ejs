<main class="not-found-main" id="not-found-main">
  <div class="not-found-stage">
    <div class="not-found-atmosphere" aria-hidden="true">
      <span class="not-found-glow not-found-glow--a"></span>
      <span class="not-found-glow not-found-glow--b"></span>
      <span class="not-found-grid"></span>
    </div>

    <div class="not-found-panel">
      <p class="not-found-code" aria-hidden="true">404</p>
      <h1 id="not-found-title" class="not-found-title"><%= t('404.title') %></h1>
      <p class="not-found-text"><%= t('404.message') %></p>

      <div class="not-found-actions">
        <a href="/" class="btn-brand not-found-primary"><%= t('404.returnHome') %></a>
      </div>

    </div>
  </div>
</main>
