<html
  lang="<%= language %>"
  dir="<%= language === 'ar' ? 'rtl' : 'ltr' %>"
>
<section id="flight-stage" class="flight-stage">
        <div class="flight-viewport" id="section-hero">
          <div id="hero-background-video-container" class="hero-bg">
            <video
              id="hero-background-video"
              class="is-active"
              autoplay
              muted
              playsinline
              webkit-playsinline
              preload="auto"
              aria-hidden="true"
              tabindex="-1"
            >
              <source
                src="/assets/videos/hero-mobile-background.mp4"
                type="video/mp4"
                media="(max-width: 699px)"
              />
              <source
                src="/assets/videos/hero-background.mp4"
                type="video/mp4"
                media="(min-width: 700px)"
              />
            </video>
            <div class="hero-bg-scrim" aria-hidden="true"></div>
            <div class="hero-glow" aria-hidden="true">
              <span class="hero-beam hero-beam--tl"></span>
              <span class="hero-beam hero-beam--tr"></span>
              <span class="hero-beam hero-beam--mid"></span>
              <span class="hero-beam hero-beam--bl"></span>
            </div>
            <div class="vignette vignette-side"></div>
            <div class="vignette vignette-bottom"></div>
          </div>

          <div class="vision-stage-bg" id="vision-stage-bg" aria-hidden="true"></div>

          <main class="main" id="hero-main">
            <div class="main-inner">
              <div class="hero">
                <aside class="hero-rail" aria-hidden="true">
                  <span class="hero-rail-dot"></span>
                  <span class="hero-rail-line"></span>
                  <span class="hero-rail-label"><%= t('home.rail') %></span>
                </aside>

                <div class="hero-copy">
                  <h1 id="hero-main-heading" class="hero-title fade-1">
                    <%- t('home.heading') %>
                  </h1>

                  <p id="hero-subtext" class="hero-sub fade-2">
                    <span class="hero-sub-full">
                      <% t('home.subtext') %>
                    </span>
                    <span class="hero-sub-mobile">
                      <%- t('home.subtextMobile') %>
                    </span>
                  </p>

                  <div id="hero-cta-group" class="cta-pill fade-3">
                    <span class="cta-pill-hint"><%= t('home.ctaHint') %></span>
                    <a href="/contact" id="hero-primary-cta-btn" class="cta-pill-btn">
                      <span><%= t('home.cta') %></span>
                    </a>
                  </div>

                  <div class="hero-status fade-4">
                    <span class="hero-status-dot" aria-hidden="true"></span>
                    <span><%= t('home.status') %></span>
                  </div>
                </div>
              </div>
            </div>
          </main>

          <div class="scroll-hint" aria-hidden="true">
            <span class="scroll-hint-line"></span>
          </div>
        </div>
      </section>

      <div id="section-vision" class="section-vision" aria-hidden="true">
        <div class="vision-particles" aria-hidden="true"></div>

        <svg
          id="vision-connectors"
          class="vision-connectors"
          fill="none"
          aria-hidden="true"
        ></svg>

        <div class="vision-pedestal" aria-hidden="true">
          <span class="pedestal-beam"></span>
          <svg
            class="pedestal-plate"
            viewBox="0 0 480 200"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <radialGradient id="pedestal-pool" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#c8dceb" stop-opacity="0.75" />
                <stop offset="28%" stop-color="#60a5fa" stop-opacity="0.4" />
                <stop offset="55%" stop-color="#2f6fa3" stop-opacity="0.16" />
                <stop offset="100%" stop-color="#1c4f8a" stop-opacity="0" />
              </radialGradient>
              <filter
                id="pedestal-ring-glow"
                x="-50%"
                y="-50%"
                width="200%"
                height="200%"
              >
                <feGaussianBlur in="SourceGraphic" stdDeviation="1.4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>
            <ellipse
              cx="240"
              cy="128"
              rx="198"
              ry="46"
              fill="url(#pedestal-pool)"
            />
            <g
              fill="none"
              stroke-linecap="round"
              filter="url(#pedestal-ring-glow)"
            >
              <ellipse
                cx="240"
                cy="128"
                rx="208"
                ry="50"
                stroke="rgba(91, 155, 207, 0.38)"
                stroke-width="1.35"
              />
              <ellipse
                cx="240"
                cy="128"
                rx="168"
                ry="40"
                stroke="rgba(91, 155, 207, 0.52)"
                stroke-width="1.45"
              />
              <ellipse
                cx="240"
                cy="128"
                rx="124"
                ry="29.5"
                stroke="rgba(168, 200, 224, 0.68)"
                stroke-width="1.55"
              />
              <ellipse
                cx="240"
                cy="128"
                rx="78"
                ry="18.5"
                stroke="rgba(147, 197, 253, 0.82)"
                stroke-width="1.7"
              />
            </g>
            <ellipse
              cx="240"
              cy="128"
              rx="22"
              ry="6"
              fill="rgba(147, 197, 253, 0.95)"
              filter="url(#pedestal-ring-glow)"
            />
          </svg>
        </div>

        <h2 class="vision-heading">
          <span><%= t('home.titleLine1') %></span>
          <span class="vision-heading-accent"><%= t('home.titleLine2') %></span>
        </h2>

        <div class="vision-stage">
          <div id="brain-landing" class="brain-landing" aria-hidden="true"></div>
        </div>

        <div class="vision-cards">
        <% (typeof visionServices !== 'undefined' && visionServices ? visionServices : []).forEach(function(row) {
          var s = row.service;
          var shortName = s.translations?.find(function(t) { return t.field === 'shortName'; })?.value
            || s.translations?.find(function(t) { return t.field === 'name'; })?.value
            || '';
          var shortDescription = s.translations?.find(function(t) { return t.field === 'shortDescription'; })?.value
            || s.translations?.find(function(t) { return t.field === 'description'; })?.value
            || '';
        %>
        <a
          href="/services/<%= s.slug %>"
          class="vision-card <%= row.cardClass %>"
          data-connector="<%= row.connector %>"
        >
          <span class="vision-card-icon" aria-hidden="true">
            <svg class="icon icon-sm"><use href="<%= row.iconHref %>"></use></svg>
          </span>
          <div class="vision-card-body">
            <h3 class="vision-card-title"><%= shortName %></h3>
            <p class="vision-card-text"><%= shortDescription %></p>
          </div>
        </a>
        <% }); %>
        </div>

        <a href="/services" class="vision-cta">
          <span><%= t('home.ctaTwo') %></span>
        </a>
      </div>

      <div class="vision-dwell" aria-hidden="true"></div>

      <section id="manifest-stage" class="manifest-stage" aria-label="About Asas Soft">
        <div class="manifest-sticky">
          <div class="manifest-top-fade" aria-hidden="true"></div>
          <div class="manifest-bottom-fade" aria-hidden="true"></div>
          <div
            class="manifest-progress"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            aria-label="Section progress"
          >
            <span id="manifest-progress-bar" class="manifest-progress-bar"></span>
          </div>
          <div id="manifest-inner" class="manifest-inner">
            <p id="manifest-text" class="manifest-text">
              <%= t('home.body') %>
            </p>
          </div>
        </div>
      </section>

      <section id="why-stage" class="why-stage" aria-label="Why Asas Soft">
        <div class="why-layout">
          <div class="why-copy">
            <div class="why-copy-text">
              <p class="why-kicker"><%= t('home.why.kicker') %></p>
              <h2 class="why-title">
                <%- t('home.why.titleHtml') %>
              </h2>
            </div>
            <a href="/contact" class="why-cta"><%= t('home.why.cta') %></a>
          </div>

          <div class="why-accordion" id="why-accordion" role="tablist" aria-label="Why Asas Soft highlights">
            <button
              type="button"
              class="why-panel why-panel--bars is-open"
              role="tab"
              id="why-panel-1"
              aria-selected="true"
              data-why-panel="0"
            >
              <div class="why-panel-head">
                <span class="why-panel-title"><%- t('home.why.p1TitleHtml') %></span>
                <span class="why-panel-index">01</span>
              </div>
              <div class="why-panel-body">
                <div
                  class="why-panel-stat"
                  data-why-value="55.46"
                  data-why-prefix="+"
                  data-why-suffix="%"
                  data-why-decimals="2"
                >
                  +0.00%
                </div>
                <p class="why-panel-desc"><%= t('home.why.p1Desc') %></p>
              </div>
              <div class="why-panel-chart why-panel-chart--bars" aria-hidden="true">
                <div class="why-bars">
                  <span class="why-bar" style="--h:52%; --i:0"></span>
                  <span class="why-bar" style="--h:78%; --i:1"></span>
                  <span class="why-bar" style="--h:58%; --i:2"></span>
                  <span class="why-bar" style="--h:100%; --i:3"></span>
                  <span class="why-bar" style="--h:42%; --i:4"></span>
                  <span class="why-bar" style="--h:28%; --i:5"></span>
                  <span class="why-bar" style="--h:70%; --i:6"></span>
                  <span class="why-bar" style="--h:48%; --i:7"></span>
                </div>
              </div>
            </button>

            <button
              type="button"
              class="why-panel"
              role="tab"
              id="why-panel-2"
              aria-selected="false"
              data-why-panel="1"
            >
              <div class="why-panel-head">
                <span class="why-panel-title"><%= t('home.why.p2Title') %></span>
                <span class="why-panel-index">02</span>
              </div>
              <div class="why-panel-body">
                <div
                  class="why-panel-stat"
                  data-why-value="32.46"
                  data-why-prefix="+"
                  data-why-suffix="%"
                  data-why-decimals="2"
                >
                  +0.00%
                </div>
                <p class="why-panel-desc"><%= t('home.why.p2Desc') %></p>
              </div>
              <div class="why-panel-chart" aria-hidden="true">
                <svg class="why-chart why-chart-area" viewBox="0 0 220 90" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="whyAreaFill2" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="rgba(96,165,250,0.35)" />
                      <stop offset="100%" stop-color="rgba(96,165,250,0)" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M0 70 C30 62, 45 48, 70 52 C95 56, 110 28, 140 34 C170 40, 190 22, 220 30 L220 90 L0 90 Z"
                    fill="url(#whyAreaFill2)"
                  />
                  <path
                    d="M0 70 C30 62, 45 48, 70 52 C95 56, 110 28, 140 34 C170 40, 190 22, 220 30"
                    fill="none"
                    stroke="rgba(96,165,250,0.7)"
                    stroke-width="1.6"
                  />
                  <line x1="110" y1="28" x2="110" y2="90" stroke="rgba(96,165,250,0.4)" stroke-width="1" />
                  <circle cx="110" cy="28" r="3.2" fill="#c8dceb" />
                </svg>
              </div>
            </button>

            <button
              type="button"
              class="why-panel"
              role="tab"
              id="why-panel-3"
              aria-selected="false"
              data-why-panel="2"
            >
              <div class="why-panel-head">
                <span class="why-panel-title"><%= t('home.why.p3Title') %></span>
                <span class="why-panel-index">03</span>
              </div>
              <div class="why-panel-body">
                <div
                  class="why-panel-stat"
                  data-why-value="35.4"
                  data-why-prefix=""
                  data-why-suffix="k"
                  data-why-decimals="1"
                >
                  0.0k
                </div>
                <p class="why-panel-desc"><%= t('home.why.p3Desc') %></p>
              </div>
              <div class="why-panel-chart" aria-hidden="true">
                <svg class="why-chart why-chart-dash" viewBox="0 0 240 90" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="whyAreaFill3" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="rgba(96,165,250,0.28)" />
                      <stop offset="100%" stop-color="rgba(96,165,250,0)" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M8 62 C40 58, 55 40, 80 44 C110 48, 125 22, 155 28 C185 34, 200 18, 220 24 L220 82 L8 82 Z"
                    fill="url(#whyAreaFill3)"
                  />
                  <path
                    d="M8 62 C40 58, 55 40, 80 44 C110 48, 125 22, 155 28 C185 34, 200 18, 220 24"
                    fill="none"
                    stroke="rgba(147, 197, 253, 0.75)"
                    stroke-width="1.5"
                    stroke-dasharray="3 4"
                  />
                  <g fill="rgba(96,165,250,0.45)" font-size="7" font-family="Outfit, sans-serif">
                    <text x="228" y="78">0</text>
                    <text x="228" y="66">10</text>
                    <text x="228" y="54">20</text>
                    <text x="228" y="42">30</text>
                    <text x="228" y="30">40</text>
                    <text x="228" y="18">50</text>
                    <text x="228" y="8">60</text>
                  </g>
                </svg>
              </div>
            </button>
          </div>
        </div>
      </section>

      <section id="products-runway" class="products-runway" aria-label="Projects">
        <!-- Featured projects carousel hidden until real project content is ready -->
        <div id="products-stage" class="products-stage">
          <div class="products-heading">
            <p class="products-kicker"><%= t('home.projects.kicker') %></p>
            <h2 class="products-title"><%= t('home.projects.title') %></h2>
          </div>
          <div class="products-rail">
            <div class="products-track" id="products-track">
              <% if (projects && projects.length > 0) { %>
                <% projects.forEach((project, index) => { %>
              <article class="products-card">
                <div class="products-card-media">
                  <a href="<%= project.externalUrl %>" target="_blank" rel="noopener noreferrer">
                    <img
                      src="<%= project.imageSrc %>"
                      alt="<%= project.slug %>"
                      width="600"
                      height="440"
                      loading="eager"
                      decoding="async"
                      aria-label="<%= project.slug %>"
                    />
                  </a>
          
                </div>
                <div class="products-card-body">
                  <span class="products-card-index"><%= (index+1).toString().padStart(2, "0") %></span>
                  <h3><%= project.translations?.find(function(tr) {
                    return tr.field === 'name';
                  })?.value %></h3>
                  <p><%= project.translations?.find(function(tr) {
                    return tr.field === 'description';
                  })?.value %></p>
                </div>
              </article>
              <% }); %>
              <% } else { %>
                <p><%= t('projects.empty') %></p>
              <% } %>
              <a
                href="/projects"
                class="products-more"
                aria-label="<%= t('home.projects.moreAria') %>"
                aria-label="View all projects"
              >
                <span class="products-more-label"><%= t('home.projects.more') %></span>
                <svg class="icon icon-sm chevron-dir" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
              </a>
            </div>
          </div>
        </div>
      </section>

