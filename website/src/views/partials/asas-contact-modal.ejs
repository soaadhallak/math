<div id="contact-modal" class="modal-overlay" hidden>
        <div class="modal modal-sm">
          <button type="button" class="modal-close" data-close="contact" aria-label="Close">
            <svg class="icon"><use href="#icon-x"></use></svg>
          </button>

          <div id="contact-form-view">
            <div class="modal-kicker">
              <svg class="icon icon-xs ice"><use href="#icon-phone"></use></svg>
              <span>Get In Touch</span>
            </div>
            <h2 class="modal-title title-brand">Feel Free to Contact Us</h2>
            <p class="modal-sub">
              We develop smart solutions for the future of your business. Let's discuss how we can help.
            </p>

            <form id="contact-form" class="contact-form">
              <div class="field">
                <label for="contact-name">Your Name</label>
                <input id="contact-name" type="text" required placeholder="Your Name" />
              </div>

              <div class="field-row">
                <div class="field">
                  <label for="contact-email">Email</label>
                  <input id="contact-email" type="email" required placeholder="name@company.com" />
                </div>
                <div class="field">
                  <label for="contact-phone">Phone</label>
                  <input id="contact-phone" type="tel" placeholder="+963 ..." />
                </div>
              </div>

              <div class="field">
                <label for="contact-service">Service</label>
                <select id="contact-service">
                  <option value="Web Development">Web &amp; Platform Development</option>
                  <option value="Mobile App">Mobile Applications</option>
                  <option value="Custom ERP">Custom ERP &amp; Business Systems</option>
                  <option value="UI/UX Design">UI/UX Design</option>
                </select>
              </div>

              <div class="field">
                <label for="contact-details">Project Details</label>
                <textarea id="contact-details" rows="2" placeholder="Tell us about your requirements..."></textarea>
              </div>

              <div class="modal-actions">
                <button type="button" class="btn-ghost" data-close="contact">Cancel</button>
                <button type="submit" class="btn-brand btn-sm">
                  <svg class="icon icon-xs"><use href="#icon-send"></use></svg>
                  <span>Send Message</span>
                </button>
              </div>
            </form>
          </div>

          <div id="contact-success-view" class="success-view" hidden>
            <div class="success-icon">
              <svg class="icon icon-md ice"><use href="#icon-check-circle"></use></svg>
            </div>
            <h3 class="success-title title-brand">Message Received</h3>
            <p class="success-text">Thank you for reaching out to Asas Soft. We will get back to you shortly.</p>
            <button type="button" class="btn-brand btn-sm" id="contact-done-btn">Done</button>
          </div>
        </div>
      </div>
