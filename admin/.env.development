# API base URL (website backend)
VITE_API_BASE_URL=http://localhost:3000

# Available i18n locales (comma-separated). Must match locale files used by the website (e.g. en, tr, ar, fr).
# Order here defines tab order in the admin translation editors.
VITE_AVAILABLE_LOCALES=en,ar,tr

# Admin build folder name (must match website ADMIN_BUILD_FOLDER; used for base path and outDir)
ADMIN_BUILD_FOLDER=admin-e2891

# Webmail (cPanel/Bluehost) URL — opened in a new tab from the sidebar "Webmail" link and "Reply" buttons.
VITE_WEBMAIL_URL=https://mail.asassoft.com:2096/login/?user=info@asassoft.com
