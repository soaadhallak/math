# Google Analytics (GA4). Leave empty to disable the gtag script. Format: G-XXXXXXXXXX
GA_MEASUREMENT_ID=G-NJ1FMEBG6K
CLARITY_PROJECT_ID=x719fedaiy

# Rate limiting (app-level; works behind Cloudflare using CF-Connecting-IP)
# Set RATE_LIMIT_ENABLED=true to enable. Use with or without Cloudflare.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Public contact form (POST /api/messages): strict per-IP cap.
RATE_LIMIT_MESSAGES_WINDOW_MS=900000
RATE_LIMIT_MAX_MESSAGES=5

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin). Leave keys empty to disable verification.
# - RECAPTCHA_SITE_KEY:   public, exposed to the browser via res.locals.recaptchaSiteKey
# - RECAPTCHA_SECRET_KEY: server-only, used to call siteverify
# - RECAPTCHA_MIN_SCORE:  reject tokens with score below this (0.0–1.0; default 0.5)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# When behind Cloudflare or another proxy, set TRUST_PROXY=true so req.ip is correct
TRUST_PROXY=true

